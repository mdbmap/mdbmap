{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-start-app",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server.ts",
	// Platform bindings (issue #122). Local dev and tests use miniflare bindings;
	// replace the production placeholders before the first deploy:
	//   wrangler d1 create mdbmap
	//   wrangler kv namespace create METADATA_KV
	//   wrangler ratelimit namespace create API_RATE_LIMIT
	// Catalogue API keys are deploy-time secrets (never committed):
	//   wrangler secret put TMDB_API_KEY
	//   wrangler secret put SIMKL_API_KEY
	//   wrangler secret put TVDB_API_KEY
	//   wrangler secret put ANIDB_CLIENT
	//   wrangler secret put ANIDB_CLIENT_VER
	// Paid sync billing (ADR-0009 / #186):
	//   wrangler secret put STRIPE_SECRET_KEY
	//   wrangler secret put STRIPE_WEBHOOK_SECRET
	//   wrangler secret put STRIPE_PRICE_ID
	"kv_namespaces": [
		{ "binding": "METADATA_KV", "id": "REPLACE_WITH_METADATA_KV_ID" },
	],
	// Overflow builds run as durable Cloudflare Workflows (ADR-0002 §overflow).
	"workflows": [
		{
			"binding": "OVERFLOW_BUILD",
			"class_name": "OverflowBuildWorkflow",
			"name": "overflow-build",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mdbmap",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
		},
	],
	"ratelimits": [
		{
			"name": "API_RATE_LIMIT",
			"namespace_id": "REPLACE_WITH_API_RATE_LIMIT_NAMESPACE_ID",
			"simple": {
				"limit": 60,
				"period": 60,
			},
		},
	],
	"env": {
		"production": {
			"kv_namespaces": [
				{
					"binding": "METADATA_KV",
					"id": "REPLACE_WITH_METADATA_KV_ID",
				},
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "mdbmap",
					"database_id": "REPLACE_WITH_D1_DATABASE_ID",
				},
			],
			"ratelimits": [
				{
					"name": "API_RATE_LIMIT",
					"namespace_id": "REPLACE_WITH_API_RATE_LIMIT_NAMESPACE_ID",
					"simple": {
						"limit": 60,
						"period": 60,
					},
				},
			],
		},
	},
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
}
