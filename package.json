{
	"name": "mdbmap",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build && bash scripts/assert-no-devtools.sh",
		"cf-typegen": "wrangler types",
		"codegen": "graphql-codegen --config codegen.ts",
		"codegen:watch": "graphql-codegen --config codegen.ts --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:pull": "drizzle-kit pull",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"deploy": "npm run build && wrangler deploy",
		"dev": "vite dev",
		"format": "oxfmt --write",
		"generate-routes": "tsr generate",
		"lint": "oxlint --fix --fix-suggestions",
		"lint:ci": "oxlint --format=github",
		"lint:style": "stylelint --fix",
		"lint:style:ci": "stylelint --custom-formatter @csstools/stylelint-formatter-github .",
		"prepare": "husky",
		"preview": "vite preview",
		"schema:imdb": "bun imdb-graphql.cli.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@fontsource/zen-maru-gothic": "^5.3.0",
		"@orpc/client": "^1.13.6",
		"@orpc/json-schema": "^1.13.6",
		"@orpc/openapi": "^1.13.6",
		"@orpc/server": "^1.13.6",
		"@orpc/tanstack-query": "^1.13.6",
		"@orpc/zod": "^1.13.6",
		"@posthog/react": "^1.7.0",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "latest",
		"@tanstack/react-query-devtools": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@urql/core": "^6.0.3",
		"better-auth": "^1.5.3",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"graphql": "^17.0.2",
		"immer": "^11.1.18",
		"lucide-react": "^1.33.0",
		"posthog-js": "^1.358.1",
		"react": "^19.2.0",
		"react-aria-components": "^1.20.0",
		"react-dom": "^19.2.0",
		"strip-undefined": "^1.0.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.1.18",
		"ts-extras": "^1.3.0",
		"type-fest": "^5.8.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@0no-co/graphqlsp": "^1.17.4",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@csstools/stylelint-formatter-github": "^2.0.0",
		"@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
		"@graphql-codegen/cli": "^7.2.0",
		"@inlang/paraglide-js": "^2.13.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "4.1.11",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "^17.4.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"stylelint": "^17.14.1",
		"stylelint-config-clean-order": "^10.0.0",
		"stylelint-config-standard": "^40.0.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vitest": "4.1.11",
		"wrangler": "^4.70.0"
	},
	"lint-staged": {
		"*": [
			"bun run lint --no-error-on-unmatched-pattern",
			"bun run lint:style",
			"bun run format"
		]
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.0",
			"onFail": "download"
		}
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		]
	}
}
